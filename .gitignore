# --- openFrameworks generated output ---------------------------------
#
# An OF project's own Makefile, config.make and addons.make ARE sources
# and have to stay tracked. This file started from a generic CMake
# template that ignored `Makefile`, which would have committed a repo
# that cannot build. Everything below is produced by `make`.

# Intermediate build tree (obj/osx/Release/..., obj/linux64/..., ...).
obj/

# The built app. bin/data is the RUNTIME DATA directory and is tracked --
# the avatars and presets live there -- so the binary and the bundle are
# ignored by name rather than ignoring all of bin/.
bin/*.app/
bin/patternForge
bin/*_debug
bin/libs/
bin/*.dll

# --- compiled artefacts ----------------------------------------------
*.d
*.o
*.obj
*.slo
*.lo
*.gch
*.pch
*.ilk
*.pdb
*.dwo
*.so
*.so.*
*.dylib
*.dll
*.a
*.lib
*.la
*.lai
*.exe
*.out
*.app
*.mod
*.smod

# --- per-platform project files projectGenerator emits ---------------
#
# The project files themselves are worth keeping; the per-user state
# inside them is not.
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
*.vcxproj.user
*.suo
*.sdf
*.opensdf
.vs/
Debug/
Release/
x64/
Win32/
*.VC.db
*.VC.opendb
.qmake.stash
*.pro.user

# --- other build systems ---------------------------------------------
build/
Build/
build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
Testing/
vcpkg_installed/

# --- editor / OS noise -----------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
*.swp
*~
.cache/
.clangd/
compile_commands.json

# --- .obj means two different things ---------------------------------
#
# `*.obj` above is the MSVC object-file pattern, and it also matches
# Wavefront .obj -- so it silently ignored every avatar mesh the drape
# simulation loads. Those are inputs, not build output.
!data/**/*.obj
!bin/data/**/*.obj

# The two meshes the app actually loads are female_m.obj and male_m.obj
# (see ofApp::loadAvatar). These came with them and nothing references
# them: the avatar is drawn with vertex colours and scene lighting, not
# textures. 32 MB of the 50 MB here, and binaries are permanent once
# committed -- so they stay on disk and out of history. Delete these four
# lines if you ever wire them up.
data/avatar/female.obj
data/avatar/female.mtl
data/avatar/*.jpg
data/avatar/*.png

# --- this app's own output -------------------------------------------
#
# Exported packages are generated (PDFs, DXF, zips), large, and rebuild
# from their own source/design-project.json. Keep the design, not the
# output.
patternForge-exports/
*.tmp
*.log
*.bak
